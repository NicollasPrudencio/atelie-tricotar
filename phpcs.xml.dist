<?xml version="1.0"?>
<ruleset name="Atelie">
    <description>Padrao de codigo do site do ateliê — WordPress Coding Standards</description>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg value="sp"/>

    <file>./web/app/mu-plugins</file>
    <file>./web/app/plugins/atelie-produto-ia</file>
    <file>./web/app/themes/atelie-theme</file>
    <file>./config</file>


    <rule ref="WordPress"/>
    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="8.1-"/>
</ruleset>
