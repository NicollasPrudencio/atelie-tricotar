{
    "name": "atelie/site",
    "type": "project",
    "license": "proprietary",
    "description": "Site do Atelie (WordPress/Bedrock + WooCommerce)",
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org"
        }
    ],
    "require": {
        "php": ">=8.1",
        "composer/installers": "^2.2",
        "vlucas/phpdotenv": "^5.6",
        "roots/bedrock-autoloader": "^1.0",
        "roots/wordpress": "^6.5",
        "roots/wp-config": "^1.0",
        "roots/wp-password-bcrypt": "^1.1",
        "wpackagist-plugin/woocommerce": "^9.0",
        "wpackagist-plugin/two-factor": "^0.9",
        "wpackagist-plugin/woocommerce-mercadopago": "*",
        "wpackagist-plugin/melhor-envio-cotacao": "*",
        "wpackagist-plugin/shortpixel-image-optimiser": "*",
        "wpackagist-plugin/wpforms-lite": "*"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^9.6",
        "roots/wordpress-no-content": "^6.5"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "roots/bedrock-autoloader": true,
            "roots/wordpress-core-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-paths": {
            "web/app/mu-plugins/{$name}/": [
                "type:wordpress-muplugin"
            ],
            "web/app/plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
            "web/app/themes/{$name}/": [
                "type:wordpress-theme"
            ]
        },
        "wordpress-install-dir": "web/wp"
    },
    "scripts": {
        "lint": "phpcs",
        "test:unit": "phpunit --configuration tests/unit/phpunit.xml",
        "test": [
            "@lint",
            "@test:unit"
        ]
    }
}
