# Segredos e config local — nunca versionar
.env
.env.local
.env.*.local

# Dependências (instaladas via composer install no CI/deploy)
/vendor
/.claude
/node_modules

# WordPress core e conteúdo de terceiros (gerenciados via composer.json)
/web/wp
/web/app/plugins/*
!/web/app/plugins/atelie-produto-ia
!/web/app/plugins/atelie-faturamento
/web/app/mu-plugins/*
!/web/app/mu-plugins/atelie-bootstrap.php
!/web/app/mu-plugins/atelie-orcamento.php
!/web/app/mu-plugins/atelie-precificacao.php
!/web/app/mu-plugins/atelie-integracoes-sync.php
/web/app/themes/*
!/web/app/themes/atelie-theme

# Dados de runtime — não é código, é conteúdo gerado
/web/app/uploads
/web/app/upgrade
/web/app/cache

# Traduções pt_BR baixadas do wordpress.org (wp language core/plugin install) —
# conteúdo de terceiro, mesma lógica do /web/wp. Precisa ser reinstalado em
# qualquer ambiente novo (dev local, CI, staging, produção).
/web/app/languages

# Artefatos locais
*.log
.DS_Store
Thumbs.db
/tests/e2e/node_modules
/tests/e2e/playwright-report
/tests/e2e/test-results
docker/_tunnel*.log
