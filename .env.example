# Copie para .env e preencha. Nunca commitar o .env de verdade.

# --- Ambiente ---
WP_ENV=development
WP_HOME=http://localhost:8000
WP_SITEURL=${WP_HOME}/wp

# --- Banco de dados ---
DB_NAME=atelie
DB_USER=atelie
DB_PASSWORD=atelie
# No Docker local, o host do banco e o nome do servico do docker-compose.yml (db), nao localhost
DB_HOST=db

# --- Chaves de segurança do WordPress ---
# Gerar em https://roots.io/salts.html (uma por ambiente, nunca reaproveitar)
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=
# Chave propria do plugin WP 2FA — sem isso, ele tenta escrever direto no wp-config.php (ver config/application.php)
WP2FA_ENCRYPT_KEY=

# --- IA de visão (autofill do painel de produto) ---
AI_VISION_PROVIDER=gemini
AI_VISION_API_KEY=
# Em dev/CI: nunca gasta credito de API de verdade
AI_MOCK_MODE=true
# Limite de itens processados por lote na criacao em massa (ver plano, secao "Criacao de produtos em massa via IA")
AI_BATCH_MAX_ITEMS=25

# --- Mercado Pago (checkout) ---
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_SANDBOX=true

# --- Melhor Envio (frete) ---
# O plugin nao usa OAuth/redirect URI — e um token unico gerado em
# melhorenvio.com.br/painel/gerenciar/tokens (ou sandbox.melhorenvio.com.br
# no ambiente de teste) e colado no menu "Melhor Envio" do wp-admin.
MELHORENVIO_TOKEN=
MELHORENVIO_SANDBOX=true

# --- Nota fiscal ---
# Decisao 2026-08-20: usar o Bling (ERP com emissor de NF-e + plugin oficial pro
# WooCommerce) em vez de integracao propria com Focus NFe/NFe.io — evita manter
# logica fiscal customizada (rejeicao da Sefaz, contingencia, etc.) numa area onde
# erro custa caro. Nao precisa de variavel de ambiente aqui: a emissao automatica
# fica 100% configurada no proprio painel do Bling (dispara sozinha quando o pedido
# e marcado como pago), sem token nem toggle no nosso codigo. So ativar quando
# existir CNPJ (hoje o ateliê e MEI ainda nao aberto) — ver docs/decisions/0001.

# --- Google Drive (importacao em massa de fotos) ---
# Client ID/Secret de um projeto no Google Cloud Console (APIs e servicos > Clientes OAuth,
# tipo "Aplicativo da Web"). Diferente do resto: a AUTORIZACAO em si (o refresh token, gerado ao
# clicar "Conectar" na tela "Importar do Drive") fica presa a conta Google de quem autorizou —
# decisao do projeto e ser sempre a conta do desenvolvedor, nao da artesa. So precisa recriar
# essas credenciais se o projeto no Google Cloud mudar; trocar de conta autorizada e so
# desconectar e conectar de novo pela tela, sem mexer aqui.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# --- Tracking / Meta CAPI ---
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
GA4_MEASUREMENT_ID=

# --- E-mail transacional (Brevo) ---
BREVO_API_KEY=

# --- Seguranca ---
WPSCAN_API_TOKEN=
